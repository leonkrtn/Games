# Aus dem Supabase-Dashboard: Project Settings → API Keys
# (Kopiere diese Datei nach .env.local, wenn du lokal mit Supabase testen willst.)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Benachrichtigungen (Web Push). Erzeugen mit: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: Kontakt für die Push-Dienste (https://… oder mailto:…). Standard: die Adresse der Seite.
VAPID_SUBJECT=

# Aus dem Supabase-Dashboard: Project Settings → API Keys
# (Kopiere diese Datei nach .env.local, wenn du lokal mit Supabase testen willst.)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Datenbank-Verbindung für Migrationen (Supabase → Connect → Session pooler). Nur für npm run migrate / den Build.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Optional: Zertifikat aus Supabase (Project Settings → Database → SSL), damit die Verbindung auch geprüft wird.
DATABASE_CA=

# Benachrichtigungen (Web Push). Erzeugen mit: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: Kontakt für die Push-Dienste (https://… oder mailto:…). Standard: die Adresse der Seite.
VAPID_SUBJECT=
